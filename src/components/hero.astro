---
import { Picture } from "astro:assets";
import heroImage from "assets/logo_2027.svg";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main class="grid lg:grid-cols-2 place-items-center pb-8 md:pt-12 md:pb-12">
  <div class="py-6 md:order-1 md:block">
    <Picture
      src={heroImage}
      alt="VisGames"
      widths={[150, 300, 450]}
      sizes="(max-width: 600px) 75vw, 480px"
      loading="eager"
      format="avif"
    />
  </div>
  <div class="p-8 m-4">
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Workshop on Visualization Play, Games, and Activities
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      We are preparing and organizing the <strong>third</strong> EuroVis Workshop
      on Visualization Play, Games, and Activities, proposed to be collocated with
      the <a
        href="https://www.eurovis.org.uk/"
        target="_blank"
        class="underline"
        rel="noopener">
        EuroVis conference</a
      > in Stuttgart, Germany during the 2027 edition.
    </p>

    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      June 2027, Stuttgart, Germany
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <span
        aria-disabled="true"
        title="Coming soon for this edition"
        class="flex gap-2 items-center justify-center px-2 py-1 border border-gray-200 rounded-sm text-base font-medium text-gray-400 cursor-not-allowed select-none">
        <Icon class="w-5 h-5" name="bx:bxl-github" />
        Submissions & Materials
      </span>
      <span
        aria-disabled="true"
        title="Coming soon for this edition"
        class="flex gap-2 items-center justify-center px-2 py-1 border border-gray-200 rounded-sm text-base font-medium text-gray-400 cursor-not-allowed select-none">
        <Icon class="w-5 h-5" name="mdi:file-document-outline" />
        EuroVis Program
      </span>
    </div>
  </div>
</main>

<section class="w-full bg-[#076af0]/10 py-6 mb-16">
  <div class="max-w-4xl mx-auto px-4">
    <p class="text-2xl text-slate-600 max-w-3xl mx-auto text-center">
      🧩 We are preparing our proposal to be part of <strong>EuroVis 2027</strong>!
      <br />
      Join us in <strong class="text-[#076af0]">Stuttgart, Germany</strong> for the next VisGames workshop. 🧩✨
    </p>
  </div>
</section>
